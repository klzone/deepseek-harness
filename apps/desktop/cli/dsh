#!/bin/sh
# Run the installed CLI without changing the invoking shell or working directory.
set -e
launcher=$0
while [ -L "$launcher" ]; do
  directory=$(CDPATH= cd -- "$(dirname -- "$launcher")" && pwd -P)
  target=$(readlink "$launcher")
  case "$target" in
    /*) launcher=$target ;;
    *) launcher=$directory/$target ;;
  esac
done
resources=$(CDPATH= cd -- "$(dirname -- "$launcher")/../../.." && pwd -P)
# Linux deb/AppImage layouts place the executable as a sibling of resources/
# under the electron-builder `executableName`; macOS keeps the bundle layout.
if [ -x "$resources/../deepseek-harness" ]; then
  ELECTRON="$resources/../deepseek-harness"
else
  ELECTRON="$resources/../MacOS/DeepSeek Harness"
fi
ELECTRON_RUN_AS_NODE=1 exec "$ELECTRON" --expose-internals "$resources/app.asar/dsh/node_modules/@deepseek-ai/dsh-desktop-host/lib/cli.js" "$@"
